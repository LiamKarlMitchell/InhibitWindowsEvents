{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Windows Event Inhibitor",
  "version": "0.1.0",
  "identifier": "com.liam.inhibit-windows-events",
  "description": "Low-level Windows hook system to suppress specific keyboard and mouse events",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:9833",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Windows Event Inhibitor",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
